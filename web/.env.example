# ---- Server only (never NEXT_PUBLIC_) ----
# LinuxONE API behind Caddy/HTTPS. The proxy at /api/lx adds the key as x-api-key.
LINUXONE_API_URL=https://148-100-78-203.sslip.io
# Create one on the VM: sudo docker compose exec -T api python3 -m app.keys create "web"
LINUXONE_API_KEY=

# ---- Feature flags (inlined at build time) ----
# Design: ward (Notion-like) | clinical (high contrast) | night (dark monitoring)
NEXT_PUBLIC_DESIGN=ward
# Let users switch designs at runtime
NEXT_PUBLIC_DESIGN_SWITCHER=true
# Data source: live (LinuxONE API) | mock (deterministic demo data in the browser)
NEXT_PUBLIC_DATA_SOURCE=live
NEXT_PUBLIC_DATA_SOURCE_SWITCHER=true
# Show the retrospective PhysioNet sepsis label (demo only)
NEXT_PUBLIC_GROUND_TRUTH=true
NEXT_PUBLIC_ALERT_TOASTS=true
NEXT_PUBLIC_HANDOVER=true
NEXT_PUBLIC_SHIFT_SUMMARY=true
NEXT_PUBLIC_WHAT_IF=true
# Advanced mode switch in settings (federated privacy models, LinuxONE system page, what-if, data source)
NEXT_PUBLIC_ADVANCED_TOGGLE=true
# Audible alarm cues (still muted until the user turns them on)
NEXT_PUBLIC_AUDIO=true
